# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=intereses_db
# Migraciones automáticas solo fuera de producción; en producción son manuales.
DB_MIGRATIONS_RUN=true

# Backend
PORT=3000
# Obligatorio, mínimo 32 caracteres. Reemplaza este valor de ejemplo.
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
# Login: el setup local genera esta clave RSA en el .env ignorado por Git.
# En producción configura el par en el gestor de secretos; no uses claves locales.
LOGIN_CRYPTO_ACTIVE_KEY_ID=
LOGIN_CRYPTO_KEYS_JSON=
# Migración gradual bcrypt -> Argon2id al iniciar sesión. Mantener false hasta aprobar el plan.
PASSWORD_REHASH_ON_LOGIN=false
ALLOWED_EMAIL_DOMAIN=@gmail.com
FRONTEND_URL=http://localhost:4200
UPLOADS_DIR=./uploads
# enforce (producción por defecto) o audit (solo staging: registra y no bloquea)
ACCESS_POLICY_MODE=enforce
# Proxies de confianza para req.ip detrás de Railway (1 por defecto)
TRUST_PROXY=1
# Swagger: por defecto true en desarrollo y false en producción.
# Pon true explícitamente si quieres exponer /api/docs en producción.
ENABLE_SWAGGER=true

# Admin inicial (seed)
ADMIN_EMAIL=admin@unipacifico.edu.co
ADMIN_PASSWORD=C0{ABX3Yk4qxs
ADMIN_NOMBRE=Proyección Social

# Estudiante demo (seed)
# En producción se omite por defecto. Usa SEED_DEMO_STUDENT=true solo si lo necesitas.
SEED_DEMO_STUDENT=false
ESTUDIANTE_EMAIL=estudiante@unipacifico.edu.co
ESTUDIANTE_PASSWORD=Estudiante123*
ESTUDIANTE_NOMBRE=Estudiante Demo
ESTUDIANTE_SEMESTRE=5

# SSO institucional (opcional)
AUTH_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# Correo SMTP (opcional; sin esto, modo simulación con log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Proyección Social <no-reply@unipacifico.edu.co>"

# Resend (recuperación de contraseña; sin esto, modo simulación con log)
# El remitente debe ser un dominio verificado en https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM="Proyección Social <no-reply@unipacifico.edu.co>"
