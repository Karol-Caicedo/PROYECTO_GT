# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=intereses_db

# Backend
PORT=3000
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
ALLOWED_EMAIL_DOMAIN=@gmail.com
FRONTEND_URL=http://localhost:4200
UPLOADS_DIR=./uploads

# Admin inicial (seed)
ADMIN_EMAIL=admin@unipacifico.edu.co
ADMIN_PASSWORD=Admin123*
ADMIN_NOMBRE=Proyección Social

# Estudiante demo (seed)
ESTUDIANTE_EMAIL=estudiante@unipacifico.edu.co
ESTUDIANTE_PASSWORD=Estudiante123*
ESTUDIANTE_NOMBRE=Estudiante Demo
ESTUDIANTE_SEMESTRE=5

# SSO institucional (opcional)
AUTH_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# Correo SMTP (opcional; sin esto, modo simulación con log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Proyección Social <no-reply@unipacifico.edu.co>"

# Resend (recuperación de contraseña; sin esto, modo simulación con log)
# El remitente debe ser un dominio verificado en https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM="Proyección Social <no-reply@unipacifico.edu.co>"
